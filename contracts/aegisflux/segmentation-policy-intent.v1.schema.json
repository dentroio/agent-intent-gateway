{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegisflux.local/schemas/segmentation/segmentation-policy-intent.v1.schema.json",
  "title": "Segmentation Policy Intent",
  "description": "Versioned shared intent for endpoint-aware segmentation placement. Clarion or operators author intent; platform adapters compile to Windows/WFP, Linux/eBPF, or enterprise placement artifacts. Endpoint evidence must not assert trusted SGT.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "intent_id",
    "title",
    "action_mode",
    "blocking_enabled",
    "lifecycle_status",
    "subject",
    "evidence_refs",
    "placement_preferences",
    "platform_adapters",
    "evidence_constraints",
    "approval",
    "ttl",
    "rollback_refs"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "segmentation_policy_intent.v1"
    },
    "intent_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 256 },
    "description": { "type": "string", "maxLength": 4096 },
    "action_mode": {
      "type": "string",
      "enum": [
        "observe",
        "audit",
        "allow",
        "deny",
        "redirect_to_proxy",
        "assign_tunnel",
        "quarantine",
        "rollback"
      ]
    },
    "blocking_enabled": {
      "type": "boolean",
      "description": "Must be false for observe/audit. Blocking modes require explicit approval and rollback."
    },
    "lifecycle_status": {
      "type": "string",
      "enum": ["draft", "review", "approved", "compiled", "retired", "expired"]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["device", "process", "agent_class", "workload", "user_session"]
        },
        "device_ids": {
          "type": "array",
          "maxItems": 256,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "process_selectors": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "image_name": { "type": "string", "maxLength": 512 },
              "command_contains": { "type": "string", "maxLength": 512 },
              "parent_image_name": { "type": "string", "maxLength": 512 }
            }
          }
        },
        "agent_class": {
          "type": "string",
          "maxLength": 128,
          "description": "Logical agent class (code_agent, research_agent, privileged_automation, unknown_runtime)."
        },
        "labels": {
          "type": "object",
          "additionalProperties": { "type": "string", "maxLength": 256 }
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "finding",
              "device",
              "process",
              "flow",
              "dns",
              "draft_control",
              "audit_bundle",
              "research_item",
              "detection_candidate"
            ]
          },
          "ref": { "type": "string", "minLength": 1, "maxLength": 256 },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] }
        }
      }
    },
    "destination_rules": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "match": { "type": "string", "maxLength": 512 },
          "port_range": { "type": "string", "maxLength": 32 },
          "protocol": { "type": "string", "enum": ["tcp", "udp", "icmp", "any"] }
        }
      }
    },
    "data_rules": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "classification": { "type": "string", "maxLength": 128 },
          "sensitivity": { "type": "string", "enum": ["public", "internal", "confidential", "restricted"] }
        }
      }
    },
    "placement_preferences": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "host",
          "proxy",
          "tunnel",
          "enterprise_gateway",
          "sse_sase",
          "firewall",
          "trustsec",
          "cloud",
          "workload"
        ]
      }
    },
    "platform_adapters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "windows_wfp": { "$ref": "#/$defs/platformAdapterCapability" },
        "linux_ebpf": { "$ref": "#/$defs/platformAdapterCapability" },
        "proxy_broker": { "$ref": "#/$defs/platformAdapterCapability" },
        "enterprise_gateway": { "$ref": "#/$defs/platformAdapterCapability" }
      },
      "minProperties": 1
    },
    "evidence_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint_may_not_assert_trusted_sgt"],
      "properties": {
        "endpoint_may_not_assert_trusted_sgt": {
          "type": "boolean",
          "const": true,
          "description": "Endpoint-originated evidence cannot assert ISE/TrustSec SGT trust. Enterprise SGT assignment remains Clarion-owned."
        },
        "allowed_evidence_classes": {
          "type": "array",
          "items": {
            "type": "string",
            "not": {
              "enum": ["trusted_sgt", "ise_sgt", "trustsec_sgt", "sgt_assignment"]
            }
          }
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": {
        "required": { "type": "boolean" },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected", "not_required"]
        },
        "refs": {
          "type": "array",
          "items": { "type": "string", "maxLength": 256 }
        },
        "actor": { "type": "string", "maxLength": 128 },
        "approved_at_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "ttl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expires_at_ms"],
      "properties": {
        "expires_at_ms": { "type": "integer", "minimum": 1 },
        "review_by_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "rollback_refs": {
      "type": "array",
      "items": { "type": "string", "maxLength": 256 }
    },
    "compiled_artifact_ids": {
      "type": "array",
      "items": { "type": "string", "maxLength": 128 }
    },
    "operator_notes": { "type": "string", "maxLength": 4096 }
  },
  "$defs": {
    "platformAdapterCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported", "compile_ready"],
      "properties": {
        "supported": { "type": "boolean" },
        "compile_ready": { "type": "boolean" },
        "max_action_mode": {
          "type": "string",
          "enum": ["observe", "audit", "allow", "deny", "redirect_to_proxy", "assign_tunnel", "quarantine", "rollback"]
        },
        "notes": { "type": "string", "maxLength": 1024 }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "action_mode": { "enum": ["observe", "audit"] } },
        "required": ["action_mode"]
      },
      "then": {
        "properties": {
          "blocking_enabled": { "const": false },
          "approval": {
            "properties": { "required": { "const": false } }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action_mode": {
            "enum": ["deny", "quarantine", "redirect_to_proxy", "assign_tunnel"]
          }
        },
        "required": ["action_mode"]
      },
      "then": {
        "properties": { "blocking_enabled": { "const": true } },
        "required": ["approval", "rollback_refs"],
        "properties": {
          "approval": {
            "required": ["required", "status", "refs"],
            "properties": {
              "required": { "const": true },
              "status": { "const": "approved" }
            }
          },
          "rollback_refs": { "minItems": 1 }
        }
      }
    }
  ]
}
